{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user profile and player preferences.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 200
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500
        },
        "theme": {
          "type": "string",
          "enum": ["dark", "light"]
        },
        "playbackRate": {
          "type": "number"
        },
        "volume": {
          "type": "number"
        },
        "lastTrackId": {
          "type": "string",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "theme", "createdAt", "updatedAt"]
    },
    "AudioTrackRecord": {
      "title": "AudioTrackRecord",
      "description": "Synced metadata and playback position for a user's audio track or podcast episode.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "artist": {
          "type": "string",
          "maxLength": 160
        },
        "album": {
          "type": "string",
          "maxLength": 160
        },
        "folderName": {
          "type": "string",
          "maxLength": 160
        },
        "fileName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 220
        },
        "duration": {
          "type": "number"
        },
        "currentTime": {
          "type": "number"
        },
        "completed": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "ownerId",
        "title",
        "fileName",
        "duration",
        "currentTime",
        "completed",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserPlaylist": {
      "title": "UserPlaylist",
      "description": "Custom playlist created by the user.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "trackIds": {
          "type": "array"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "ownerId", "name", "trackIds", "createdAt", "updatedAt"]
    },
    "AudioTranscription": {
      "title": "AudioTranscription",
      "description": "Voice recording transcription generated via Gemini 3.5 Transcribe.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "durationSec": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "ownerId", "title", "text", "durationSec", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user profile and player preferences."
    },
    "/users/{userId}/tracks/{trackId}": {
      "schema": { "$ref": "#/entities/AudioTrackRecord" },
      "description": "User's synced audio track metadata and playback progress."
    },
    "/users/{userId}/playlists/{playlistId}": {
      "schema": { "$ref": "#/entities/UserPlaylist" },
      "description": "User's custom playlists."
    },
    "/users/{userId}/transcriptions/{transcriptionId}": {
      "schema": { "$ref": "#/entities/AudioTranscription" },
      "description": "User's saved microphone audio transcriptions."
    }
  }
}
